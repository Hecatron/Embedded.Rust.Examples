{
    // See https://go.microsoft.com/fwlink/?LinkId=733558 
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            // Build for Debugging
            "label": "build-debug",
            "type": "process",
            "command": "cargo",
            "args": [
                "build",
                "--example", "${fileDirnameBasename}",
                "--features", "${config:rust-analyzer.cargo.features}"
            ],
            "problemMatcher": [
                "$rustc",
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always"
            }
        },
        {
            // Build for Release
            "label": "build-release",
            "type": "process",
            "command": "cargo",
            "args": [
                "build",
                "--release",
                "--example", "${fileDirnameBasename}",
                "--features", "${config:rust-analyzer.cargo.features}"
            ],
            "problemMatcher": [
                "$rustc",
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always"
            }
        },
        {
            // Clean the build
            "label": "clean",
            "command": "cargo",
            "args": [
                "clean"
            ],
            "presentation": {
                "reveal": "always"
            }
        },
        {
            // Run the Build
            "label": "run",
            "command": "cargo",
            "args": [
                "run"
            ],
            "presentation": {
                "reveal": "always"
            }
        },
        {
            // Run tests
            "label": "test",
            "command": "cargo",
            "args": [
                "test"
            ],
            "presentation": {
                "reveal": "always"
            },
            "group": {
                "kind": "test",
                "isDefault": false
            }
        },
        {
            // cargo bench
            "label": "bench",
            "command": "cargo",
            "args": [
                "bench"
            ],
            "presentation": {
                "reveal": "always"
            },
            "group": "test"
        },
        {
            // Display VSCode Variables
            // https://code.visualstudio.com/docs/reference/variables-reference
            "label": "echo",
            "type": "shell",
            "command": "echo Test: ${workspaceFolder}"
        }
    ]
}
