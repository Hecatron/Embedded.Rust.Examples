// Available variables which can be used inside of strings.
// ${workspaceRoot}: the root folder of the team
// ${file}: the current opened file
// ${fileBasename}: the current opened file's basename
// ${fileDirname}: the current opened file's dirname
// ${fileExtname}: the current opened file's extension
// ${cwd}: the current working directory of the spawned process
{
    "version": "2.0.0",
    "tasks": [
        {
            // Build for Debugging
            "label": "build_debug",
            "type": "process",
            "command": "cargo",
            "args": [
                "build",
                "--features",
                "${config:rust-analyzer.cargo.features}"
            ],
            "problemMatcher": [
                "$rustc",
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always"
            }
        },
        {
            // Build for Release
            "label": "build_release",
            "type": "process",
            "command": "cargo",
            "args": [
                "build",
                "--release",
                "--features",
                "${config:rust-analyzer.cargo.features}"
            ],
            "problemMatcher": [
                "$rustc",
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always"
            }
        },
        {
            // Clean the build
            "label": "clean",
            "command": "cargo",
            "args": [
                "clean"
            ],
            "presentation": {
                "reveal": "always"
            }
        },
        {
            // Run the Build
            "label": "run",
            "command": "cargo",
            "args": [
                "run"
            ],
            "presentation": {
                "reveal": "always"
            }
        },
        {
            // Run tests
            "label": "test",
            "command": "cargo",
            "args": [
                "test"
            ],
            "presentation": {
                "reveal": "always"
            },
            "group": {
                "kind": "test",
                "isDefault": false
            }
        },
        {
            // cargo bench
            "label": "bench",
            "command": "cargo",
            "args": [
                "bench"
            ],
            "presentation": {
                "reveal": "always"
            },
            "group": "test"
        },
        {
            // Display VSCode Variables
            // https://code.visualstudio.com/docs/reference/variables-reference
            "label": "echo",
            "type": "shell",
            "command": "echo Test: ${workspaceFolder}"
        }
    ]
}